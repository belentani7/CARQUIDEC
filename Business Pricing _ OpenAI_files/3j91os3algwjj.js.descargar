      vec2 drift = vec2(
        motionTime * 0.34 + sin(motionTime * 0.41) * 0.12,
        -motionTime * 0.07 + cos(motionTime * 0.29) * 0.10
      );

      vec2 firstWarp = vec2(
        fbm(point * 1.05 + drift),
        fbm(point * 1.05 + drift + vec2(4.8, 1.7))
